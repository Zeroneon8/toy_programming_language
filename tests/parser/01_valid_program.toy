-- Programa completo valido en Toy
func factorial(number n)
  if n == 1 then
    ret 1
  end
  ret n * factorial(n - 1)
end

func saludar(string msg, number veces)
  for number k := 1, veces do
    println msg
  end
end

func main()
  number i := 0
  while i <= 10 do
    print(i)
    i := i + 1
  end
  for number j := 100, 1, -3 do
    local string s := 'valor: ' + j
    println s
  end
  saludar("hola", 3)
end

main()